# Local development - Vite proxy handles /api requests to localhost:5000
# Leave VITE_API_URL empty to use Vite proxy (recommended for local dev)
# VITE_API_URL=http://localhost:5000

# For production deployment on Render/Vercel, set this to your backend URL:
# VITE_API_URL=https://invitor-backend-erut.onrender.com